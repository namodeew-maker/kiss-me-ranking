# ============ Kiss Me Ranking — Production Environment ============
# Copy this file to /var/www/kiss-me-ranking/.env and fill in real values

# ---------- Server ----------
NODE_ENV=production
PORT=3010

# ---------- Database (Neon / PostgreSQL) ----------
# Option 1: Use existing Neon DB (recommended — no migration needed)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Option 2: Use local PostgreSQL on VPS (uncomment below, remove DATABASE_URL above)
# DB_USER=kissme
# DB_HOST=localhost
# DB_NAME=kissme_ranking
# DB_PASSWORD=YOUR_STRONG_PASSWORD_HERE
# DB_PORT=5432

# ---------- Cloudflare R2 Storage ----------
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_BUCKET=kissme-ranking
R2_PUBLIC_URL=https://your-r2-public-url.r2.dev
REQUIRE_R2_STORAGE=true

# ---------- Admin ----------
# Change this to a secret path! e.g. mysecretpanel123
ADMIN_LOGIN_PATH=admin
AUTH_SESSION_SECRET=replace_with_a_long_random_secret
ADMIN_SESSION_TTL_MS=28800000

# ---------- Performance ----------
PG_POOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=10000
PG_QUERY_TIMEOUT_MS=15000
PG_STATEMENT_TIMEOUT_MS=15000
PG_MAX_USES=7500
READ_API_RATE_LIMIT_MAX=900
WRITE_API_RATE_LIMIT_MAX=180
LOGIN_RATE_LIMIT_MAX=5
PUBLIC_API_CACHE_SECONDS=15
PUBLIC_API_CACHE_STALE_SECONDS=45

# ---------- Current login flow ----------
# Production ปัจจุบันใช้ LINE LIFF ฝั่ง client เพื่อ login/สร้าง user ครั้งแรกเท่านั้น
# จึงไม่ต้องตั้ง LINE server-side OAuth callback หรือ Company webhook ใน template หลักนี้
