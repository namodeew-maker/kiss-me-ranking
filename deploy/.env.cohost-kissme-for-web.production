# ============ Kiss Me Ranking — Production Environment ============
# Co-host profile: run this app beside kissme-for-web on the same VPS.
#
# Copy this file to:
#   /var/www/kiss-me-ranking/.env
#
# Important:
#   - Do not deploy this project into /opt/kissme-for-web
#   - Keep kissme-for-web on PORT=3000
#   - Run Kiss Me Ranking on PORT=3010

# ---------- Server ----------
NODE_ENV=production
PORT=3010

# ---------- Database (Neon / PostgreSQL) ----------
# Option 1: Use existing Neon DB (recommended — no migration needed)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Option 2: Use local PostgreSQL on VPS (uncomment below, remove DATABASE_URL above)
# DB_USER=kissme
# DB_HOST=localhost
# DB_NAME=kissme_ranking
# DB_PASSWORD=YOUR_STRONG_PASSWORD_HERE
# DB_PORT=5432

# ---------- Cloudflare R2 Storage ----------
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_BUCKET=kissme-ranking
R2_PUBLIC_URL=https://your-r2-public-url.r2.dev
REQUIRE_R2_STORAGE=true

# ---------- Admin ----------
# Use a dedicated path so it does not collide with /admin from kissme-for-web.
ADMIN_LOGIN_PATH=ranking-admin

# ---------- Current login flow ----------
# Production ปัจจุบันใช้ LINE LIFF ฝั่ง client เพื่อ login/สร้าง user ครั้งแรกเท่านั้น
# จึงไม่ต้องตั้ง LINE server-side OAuth callback หรือ Company webhook ใน template หลักนี้
