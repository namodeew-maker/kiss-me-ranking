# PostgreSQL connection (local)
DB_USER=postgres
DB_HOST=localhost
DB_NAME=lotto_project
DB_PASSWORD=your_password_here
DB_PORT=5432

# Or use a full connection string (for Neon / Render / Railway)
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Cloudflare R2 (image storage)
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY=your_access_key_id
R2_SECRET_KEY=your_secret_access_key
R2_BUCKET=kissme-ranking
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# Server port
PORT=3010

# Admin login path (default: /admin)
# Example: ADMIN_LOGIN_PATH=kissme-backoffice
ADMIN_LOGIN_PATH=admin
AUTH_SESSION_SECRET=replace_with_a_long_random_secret
ADMIN_SESSION_TTL_MS=28800000

# PostgreSQL pool tuning
PG_POOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=10000
PG_QUERY_TIMEOUT_MS=15000
PG_STATEMENT_TIMEOUT_MS=15000
PG_MAX_USES=7500

# API rate limiting
READ_API_RATE_LIMIT_MAX=900
WRITE_API_RATE_LIMIT_MAX=180
LOGIN_RATE_LIMIT_MAX=5

# Public API cache headers (seconds)
PUBLIC_API_CACHE_SECONDS=15
PUBLIC_API_CACHE_STALE_SECONDS=45

# Shared secret for Google Sheets / Apps Script export endpoint
# Apps Script should send this value as Authorization: Bearer <token>
EXPORT_SYNC_SECRET=replace_with_a_long_random_secret
